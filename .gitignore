node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build Output ──────────────────────────────────
frontend/dist/

# ── IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────
docker-compose.override.yml

