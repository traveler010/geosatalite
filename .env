# ==============================================================================
# SatQuery AI — Environment Variables
# ==============================================================================

# Backend Port (mapped to host)
PORT=8000

# Backend Inference Mode (true: fast mock pipeline, false: real ML model checkpoints)
SATQUERY_MOCK=true

# Checkpoint model directory path (inside container)
SATQUERY_MODEL_DIR=/app/backend/checkpoints

# Allowed CORS origins (comma-separated)
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend API URL (for Vite build and client queries)
VITE_BACKEND_URL=http://localhost:8000

# NASA APOD Integration
NASA_BASE_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic
NASA_API_KEY=mrcH27uIs4gX9tPYIeBl0GFD62p49pMxmlas7vlq4

